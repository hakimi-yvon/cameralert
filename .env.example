# ============================================================
# CamerAlert — Variables d'environnement
# Copiez ce fichier en .env pour votre configuration locale/production
# ============================================================

# Sécurité (Obligatoire en production : générer une clé aléatoire sécurisée)
SECRET_KEY=votre_cle_secrete_tres_longue_et_aleatoire
DEBUG=False
ALLOWED_HOSTS=cameralert.onrender.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://cameralert.onrender.com

# Base de données PostgreSQL (Ex: Render, Supabase, Neon)
# En local sans DATABASE_URL, le projet utilisera db.sqlite3 automatiquement
DATABASE_URL=postgres://utilisateur:mot_de_passe@hote:5432/nom_base

# Stockage Cloudinary pour les photos uploadées (Obligatoire en prod pour persister les images)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# Configuration E-mail (SMTP) pour les alertes aux familles
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre_adresse@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application_google
DEFAULT_FROM_EMAIL=CamerAlert <noreply@cameralert.cm>
